# Supabase public configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Supabase server-only key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Comma-separated Discord snowflakes allowed to administer the platform.
ADMIN_DISCORD_IDS=123456789012345678

# Google emails allowed to access the private 101Devs master dashboard.
MASTER_ADMIN_GOOGLE_EMAILS=jukersrx@gmail.com
MASTER_ADMIN_SITE_URL=https://101devs.com
# Shared only between trusted deployments so 101Devs can aggregate their summaries.
MASTER_DASHBOARD_SHARED_SECRET=
MASTER_SERVICE_ID=gwstore
GWSTORE_ADMIN_URL=https://gwstore.vercel.app
THSTORE_ADMIN_URL=https://thstoreadm.vercel.app

# Metrics API of the 40 Sobremesas Fit site, read by the /admin dashboard.
# The key must match METRICS_API_KEY on that project. Server-only.
SOBREMESAS_FIT_METRICS_URL=https://petrakis.com.br
SOBREMESAS_FIT_METRICS_KEY=

# Legacy compatibility only: required by the old encrypted-unit import endpoints,
# not by the aggregate stock field edited on each product.
INVENTORY_ENCRYPTION_KEY=replace_with_32_random_bytes_in_base64
INVENTORY_FINGERPRINT_KEY=replace_with_an_independent_random_base64_key

# Canonical production domain. Use http://localhost:3000 only in local .env files.
NEXT_PUBLIC_SITE_URL=https://gwstore.vercel.app

# Public white-label identity. Each deployment has its own values.
NEXT_PUBLIC_STORE_NAME=GWStore
NEXT_PUBLIC_STORE_CATALOG_LABEL=Grow a Garden 2
# Optional HTTPS image URL. When empty, non-GWStore deployments use initials.
NEXT_PUBLIC_STORE_LOGO_URL=
# Optional absolute HTTPS banner shown above the Discord storefront.
DISCORD_STOREFRONT_BANNER_URL=

# Discord bot (server-only). The public key verifies HTTP Interactions.
DISCORD_APPLICATION_ID=123456789012345678
DISCORD_PUBLIC_KEY=replace_with_the_64_character_hex_public_key
DISCORD_BOT_TOKEN=replace_with_the_discord_bot_token

# Protects Vercel's durable Discord ticket-close reconciliation endpoint.
CRON_SECRET=replace_with_at_least_32_random_characters

# LivePix OAuth client credentials (server-only). The app uses its own account,
# so this integration uses client_credentials and does not require an OAuth callback.
LIVEPIX_CLIENT_ID=replace_with_the_livepix_client_id
LIVEPIX_CLIENT_SECRET=replace_with_the_livepix_client_secret

# Optional: register slash commands in one guild for immediate development
# instead of globally (global commands can take time to propagate).
DISCORD_GUILD_ID=

# Roulette overlay token (server-only). The overlay is a public page with no
# session — the token in its URL is the only thing gating it, so each store
# needs its own value and it must never be shared between deployments.
# Missing it makes the overlay answer 404 even where the roulette is enabled.
ROULETTE_OVERLAY_TOKEN=replace_with_at_least_32_random_characters
